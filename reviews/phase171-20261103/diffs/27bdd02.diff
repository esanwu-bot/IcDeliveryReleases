@@ -174,6 +174,44 @@ def parse_pdf(pdf: Path, mpn: str, datasheet_url: str = "", *,
         meta = doc.setdefault("metadata", {})
         if errs:
             meta["quality_warning"] = "; ".join(errs)
+
+        # ---- 确定性抽取：与 parse_datasheets.parse_one **同一份实现** ----
+        # Phase 1.7 D1（2026-11-03）：V2 曾漏掉这一步 —— 同一份 LM317 PDF，
+        # Legacy 热阻 34 行、V2 却是模型原样的 36 行（含 `NA`/`—`）。根因不是
+        # 模型方差，是链路没执行相同的确定性后处理。这里**只调用** qc 的同一份
+        # `apply_deterministic`，不复制任何判据；调用时机与 Legacy 一致：
+        # 模型输出校验通过 → 确定性覆盖 → 核心字段校验 → 不达标时一次修复重试后
+        # **再覆盖一次**（避免拿模型的脏行去覆盖重试稿）。
+        from qc import core_validation as _CV                    # noqa: PLC0415
+        from qc import deterministic_extract as DE                # noqa: PLC0415
+
+        det_rep: dict = {}
+
+        def _apply_deterministic() -> None:
+            nonlocal det_rep
+            try:
+                import pymupdf as _fitz                          # noqa: PLC0415
+                with _fitz.open(str(pdf)) as _fd:
+                    det_rep = DE.apply_deterministic(doc, _fd)
+            except ImportError:
+                det_rep = {"skipped": "pymupdf 不可用，确定性抽取未执行"}
+            except Exception as e:                              # noqa: BLE001
+                det_rep = {"error": f"{type(e).__name__}: {e}"[:200]}
+
+        _apply_deterministic()
+        core_errs = DE.check_core(doc, det_rep) + DE.check_acceptance(doc, mpn)
+        if core_errs:
+            messages += [
+                {"role": "assistant", "content": content[:6000]},
+                {"role": "user", "content": "核心字段不达标：" + "；".join(core_errs) +
+                 "。请修正并重新输出完整 JSON（只输出 JSON，保持全部 key）。"},
+            ]
+            content = call(messages, "repair", 3, temperature=0.0,
+                           enable_thinking=True, max_tokens=pd.RETRY_MAX_TOKENS)
+            doc, _clean_stats = pd.parse_doc_clean(content)
+            _apply_deterministic()
+            core_errs = DE.check_core(doc, det_rep) + DE.check_acceptance(doc, mpn)
+
         try:
             conf = float(meta.get("confidence") or 0)
         except (TypeError, ValueError):
@@ -189,6 +227,10 @@ def parse_pdf(pdf: Path, mpn: str, datasheet_url: str = "", *,
             "confidence": round(max(0.0, min(1.0, conf)), 2),
             "requested_mpn": mpn,
         })
+        # 确定性处理的改动摘要 + 核心字段校验：与 Legacy 同名字段，下游能用
+        # 同一套审计脚本回答「这条链到底跑没跑确定性抽取」。
+        meta["deterministic_extract"] = det_rep
+        meta["core_validation"] = _CV.stamp(meta, doc, core_errs or _CV.PASS)
         bi = doc.setdefault("basic_info", {})
