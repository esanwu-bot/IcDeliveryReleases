+def _stamp_row_subjects(doc: dict, document_scope: str) -> int:
+    """给板卡 doc 的 `thermal` / `esd` 每一行标主体（**不搬容器**）。
+
+    证据口径（与裁决表一致，只认能落到这一行来源的事实）：
+
+    | 来源证据 | 主体 |
+    |---|---|
+    | `onboard_device_datasheet`（这份 PDF 是器件手册）| `onboard_device` |
+    | `board_user_guide`（与请求号绑定的板卡 UG）| `board` |
+    | 无法确认 | `ambiguous`（保留行、标待人工，**不自动归属**）|
+
+    为什么不按参数名猜：`RθJA` 在板卡 UG 里也可能引用器件值，
+    `HBM` 也可能指整板接口保护 —— 单看名字无法区分主体。一个 item 只有一份
+    PDF，所以「这份文档是什么」才是可复算的证据。
+    """
+    scope = str(document_scope or "")
+    subject = ("onboard_device" if scope == "onboard_device_datasheet"
+               else "board" if scope == "board_user_guide"
+               else "ambiguous")
+    counts: dict[str, dict[str, int]] = {}
+    for key in ("thermal", "esd"):
+        rows = (doc.get("specs") or {}).get(key) or []
+        per = counts.setdefault(key, {})
+        for row in rows:
+            if not isinstance(row, dict):
+                continue
+            # 上游显式给过主体就尊重它（同一份 doc 幂等重跑不会翻转）
+            row.setdefault("subject", subject)
+            row.setdefault("subject_source", scope or "unresolved")
+            if row["subject"] == "ambiguous":
+                row.setdefault("subject_review", "needs_human")
+            per[row["subject"]] = per.get(row["subject"], 0) + 1
+    if counts:
+        doc.setdefault("specs", {})["subject_summary"] = counts
+    return sum(sum(v.values()) for v in counts.values())
+
+
