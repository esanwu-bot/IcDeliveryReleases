     return -1
 
 
+# ---------------------------------------------------------------- D4：PIN | FUNCTION 布局
+#: 引脚单元格：`1` / `3` / `2, TAB` / `A1` / `—`（封装列里没有该脚时的占位）。
+#: `2, TAB` 是 SOT-223 的「2 脚 + 散热片」，取前导数字 `2` 作为 pin 值；
+#: 原始单元格另存进 `pins_by_package`（仅当各封装列不同时）。
+_PIN_CELL_RE = re.compile(
+    r"^(?:\d+(?:\s*,\s*(?:TAB|EP|PAD|THERMAL|NC))?|[A-Z]\d{1,2})$", re.I)
+#: 引脚名只允许**短大写符号**（`ADJUST` / `CS/FS` / `VOUT`）。
+#: 功能描述一定含小写与句末标点 —— 这是「描述绝不能被当成引脚名」的硬闸。
+_PIN_NAME_RE = re.compile(r"^[A-Z][A-Z0-9_/\- ]{0,30}$")
+#: 封装列表头：`TO-220` / `TO-263` / `SOT-223` / `SOIC` / `VQFN` …
+_PKG_HEAD_RE = re.compile(
+    r"^(?:TO-\d+|SOT-\d+|SOIC|PDIP|TSSOP|SSOP|VQFN|QFN|LCCC|CDIP|"
+    r"[A-Z]{2,5}-\d+|[A-Z]{3})$")
+
+
+def _pin_cellish(s: str) -> bool:
+    return bool(_PIN_CELL_RE.match((s or "").strip()))
+
+
+def _pin_nameish(s: str) -> bool:
+    s = (s or "").strip()
+    return (bool(s) and bool(_PIN_NAME_RE.match(s))
+            and s not in IO_MARKS and s not in HEADER_WORDS)
+
+
+def _pin_cells(ls: list[str], i: int, cap: int = 8) -> tuple[list[str], int]:
+    """从 `ls[i]` 起读连续的引脚单元格（每个封装列一格）。"""
+    j, cells = i, []
+    while j < len(ls) and len(cells) < cap and _pin_cellish(ls[j]):
+        cells.append(ls[j].strip())
+        j += 1
+    return cells, j
+
+
+def _pin_value(cell: str) -> str:
+    """单元格 → pin 值：`2, TAB` → `2`；`A1` → `A1`；`—` → 空。"""
+    m = re.match(r"^([A-Z]\d{1,2}|\d+)", (cell or "").strip())
+    return m.group(1) if m else ""
+
+
+def _wide_header_start(ls: list[str]) -> int:
+    """`PIN … NAME … DESCRIPTION/FUNCTION` 表头之后的扫描起点。
+
+    只认**同一段**里同时出现 `PIN` / `NAME` / `DESCRIPTION`（或 `FUNCTION`）：
+    封装俯视图里也有 ADJUST/OUTPUT，但它们没有这个表头。
+    """
+    for k, s in enumerate(ls):
+        if s.strip().upper() != "PIN":
+            continue
+        win = [x.strip().upper() for x in ls[k:k + 10]]
+        if "NAME" in win and ("DESCRIPTION" in win or "FUNCTION" in win):
+            return k + 1
+    return -1
+
+
+def _package_names(ls: list[str], a: int, b: int) -> list[str]:
+    """表头到首行之间的封装列名（`TO-220 (Legacy Chip)` 合并成一项）。"""
+    out: list[str] = []
+    for s in ls[a:b]:
+        s = s.strip()
+        if not s:
+            continue
+        if s.startswith("(") and out:
+            out[-1] = f"{out[-1]} {s}"
+            continue
+        if "(" in s or _PKG_HEAD_RE.match(s):
+            if s.upper() not in ("PIN", "NAME", "DESCRIPTION", "FUNCTION", "I/O"):
+                out.append(s)
+    return out
+
+
+def _wide_row_start(ls: list[str], i: int, n: int) -> bool:
+    """`ls[i]` 是「名字 + n 个封装脚号」的一行起点。
+
+    描述行一定不满足：名字闸（短大写）先挡掉，其次要求紧跟 n 个单元格，
+    且第 n+1 行是 I/O 标记或描述（不是又一个脚号）。
+    """
+    if not _pin_nameish(ls[i]):
+        return False
+    cells, j = _pin_cells(ls, i + 1, n)
+    if len(cells) != n:
+        return False
+    nxt = ls[j].strip() if j < len(ls) else ""
+    if nxt in IO_MARKS:
+        return True
+    return bool(nxt) and not _pin_cellish(nxt) and not _pin_nameish(nxt)
+
+
+def _extract_pins_wide(ls: list[str], start: int, page_no: int) -> list[dict]:
+    """解析 `PIN | I/O | DESCRIPTION | NAME | <N 个封装列>` 布局。
+
+    LM317 的真实排版（p5）::
+
+        PIN  I/O  DESCRIPTION  NAME  TO-220  TO-263  SOT-223
+        ADJUST                  1       1       1       —   Output voltage adjustment pin…
+        INPUT                   3       3       3       I   Input voltage pin…
+        OUTPUT                  2, TAB  2, TAB  2, TAB  O   Output voltage pin…
+
+    多封装列的脚号可能不同：pin 取第一列的号，其余写进 `pins_by_package`，
+    **不猜、不丢**。
+    """
+    out: list[dict] = []
+    n, first = 0, -1
+    for i in range(start, len(ls) - 1):
+        if not _pin_nameish(ls[i]):
+            continue
+        cells, j = _pin_cells(ls, i + 1, 8)
+        if not cells:
+            continue
+        nxt = ls[j].strip() if j < len(ls) else ""
+        if nxt in IO_MARKS or (nxt and not _pin_cellish(nxt) and not _pin_nameish(nxt)):
+            n, first = len(cells), i
+            break
+    if n == 0 or first < 0:
+        return out
+    pkgs = _package_names(ls, start, first)
+
+    i = first
+    while i < len(ls):
+        if not _wide_row_start(ls, i, n):
+            i += 1
+            continue
+        name = ls[i].strip()
+        cells, j = _pin_cells(ls, i + 1, n)
+        if j < len(ls) and ls[j].strip() in IO_MARKS:
+            j += 1
+        desc: list[str] = []
+        while j < len(ls):
+            if _wide_row_start(ls, j, n):
+                break
+            if re.match(r"^\(\d+\)", ls[j]):          # 表脚注
+                break
+            if FOOTER_RE.search(ls[j]):               # 页脚
+                break
+            d = ls[j].strip()
+            if d and d.upper() not in HEADER_WORDS:
+                desc.append(d)
+            j += 1
+        text = re.sub(r"\s+", " ", " ".join(desc)).strip()
+        vals = [_pin_value(c) for c in cells]
+        pin = next((v for v in vals if v), "")
+        rec = {"pin": pin, "name": name, "description": text, "page": page_no + 1}
+        if len({v for v in vals if v}) > 1 and len(pkgs) == n:
+            rec["pins_by_package"] = {p: v for p, v in zip(pkgs, vals) if v}
+        out.append(rec)
+        i = j
+    return out
+
+
 def _cell(row: list, i: int) -> str:
     if i < 0 or i >= len(row):
         return ""
