  "basic_info": {
    "mpn": "LM317",
    "manufacturer": "Texas Instruments",
    "category": "Integrated Circuits (ICs)",
    "subcategory": "Voltage Regulators",
    "description": "The LM317 is an adjustable three-pin positive voltage regulator capable of supplying up to 1.5A over an output voltage range of 1.25V to 37V. It features low line and load regulation, internal current limiting, thermal overload protection, and safe-area compensation. Available in multiple packages including SOT-223 (DCY), TO-263 (KTT), and TO-220 (KCS/KCT) for legacy chip variants.",
